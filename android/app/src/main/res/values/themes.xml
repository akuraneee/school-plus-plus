<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF15181E</color>
    <color name="icon_bg">#FF2F6FDE</color>

    <!-- Тёмная тема Material: WebView получает prefers-color-scheme: dark, и панель Schools++ становится тёмной. -->
